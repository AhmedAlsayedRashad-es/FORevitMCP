<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests the Roslyn C# runner of the Revit add-in outside Revit: wrapping, compile against the Revit 2026 API, error line numbers, MiniJson.
       Revit API dlls cannot load outside Revit, so the test compiles only; it does not run scripts.
       Build the add-in first: dotnet build src/Addin -c Release -p:RevitVersion=2026 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
