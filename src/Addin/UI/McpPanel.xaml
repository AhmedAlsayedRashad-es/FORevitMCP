<Page x:Class="FirstOption.RevitMcp.Addin.UI.McpPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="FirstOption MCP"
      FontFamily="Segoe UI" FontSize="12"
      Background="#F3F3F3" MinWidth="260">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FirstOption.RevitMcp.Addin;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                <TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="FirstOption MCP" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- server status -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Style="{StaticResource SmallButton}" />
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="StatusText" Text="Checking pyRevit Routes..." FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Port" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PortText" Text="-" FontWeight="SemiBold" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="1" Text="Revit" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RevitText" Text="-" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="2" Text="Document" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DocumentText" Text="-" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="3" Text="pyRevit" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PyRevitText" Text="-" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="4" Text="Python" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PythonText" Text="-" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="5" Text="C# runner" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="RunnerText" Text="-" Style="{StaticResource FieldValue}" />
                </Grid>
                <TextBlock x:Name="OfflineHint" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" Foreground="{StaticResource ErrorBrush}" />
                <TextBlock x:Name="CheckedText" Text="Last check: -" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- MCP activity -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="MCP activity" Style="{StaticResource CardTitle}" />
                <TextBlock Grid.Row="1" Text="Last agent call" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastCallText" Text="-" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="2" Text="This session" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SessionCountText" Text="0 commands" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="3" Text="Library" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LibraryText" Text="-" Style="{StaticResource FieldValue}" />
            </Grid>
        </Border>

        <!-- GitHub upload notice: shown when the MCP pushes the library -->
        <Border Grid.Row="3" x:Name="PushBanner" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="CloseBanner_Click" Style="{StaticResource LinkButton}" VerticalAlignment="Top" ToolTip="Close" />
                <StackPanel>
                    <TextBlock Text="Uploaded to GitHub" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Margin="0,4,0,0"><Hyperlink Click="BannerView_Click">View commit</Hyperlink></TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- executed commands -->
        <DockPanel Grid.Row="4" Margin="0,0,0,4">
            <TextBlock x:Name="ListCountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Executed commands" FontWeight="SemiBold" />
        </DockPanel>
        <ListBox Grid.Row="5" x:Name="CommandsList" SelectionChanged="CommandsList_SelectionChanged"
                 BorderBrush="{StaticResource LineBrush}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontWeight="Bold" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="#6B7280" FontSize="11" Margin="6,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="5" x:Name="EmptyText" Margin="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                   Text="No commands yet. Ask Claude Code or Codex to do something in Revit." />

        <!-- details of the selected command -->
        <Border Grid.Row="6" x:Name="DetailsPanel" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,2">
                    <Button DockPanel.Dock="Right" Content="Copy code" Click="CopyCode_Click" Style="{StaticResource LinkButton}" />
                    <TextBlock x:Name="CodeLabel" Text="Code" FontWeight="SemiBold" />
                </DockPanel>
                <TextBox x:Name="CodeBox" Style="{StaticResource CodeBox}" Height="120" />
                <TextBlock x:Name="OutputLabel" Text="Output" FontWeight="SemiBold" Margin="0,6,0,2" />
                <TextBox x:Name="OutputBox" Style="{StaticResource CodeBox}" Height="90" />
            </StackPanel>
        </Border>

        <!-- footer -->
        <WrapPanel Grid.Row="7" Margin="0,8,0,0">
            <Button Content="Open log folder" Click="OpenLog_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" />
            <Button Content="Clear list" Click="Clear_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" />
            <Button Content="GitHub Settings" Click="GitHub_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,4" />
        </WrapPanel>
    </Grid>
</Page>
